ground:#2bd8a014;border-color:#2bd8a0}.crm-attention-empty{color:#7c9ab3;border:1px dashed #2b4a61;border-radius:10px;grid-column:1/-1;justify-content:center;align-items:center;gap:7px;min-height:54px;font-size:10px;display:flex}.crm-attention-more{color:#55d9ce;cursor:pointer;background:0 0;border:0;grid-column:1/-1;justify-self:start;padding:3px 2px;font-size:10px;font-weight:700}.crm-attention-more:hover{color:#a2fff6}.crm-stale-deals{border-top:1px solid #20354f;margin-top:12px;padding-top:11px}.crm-stale-deals__label{color:#8da6bf;align-items:center;gap:6px;font-size:10px;font-weight:700;display:flex}.crm-stale-deals__list{grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-top:8px;display:grid}.crm-stale-deals__list button{color:#8da6bf;text-align:left;cursor:pointer;background:#0813216b;border:1px solid #203a54;border-radius:8px;justify-content:space-between;align-items:center;gap:8px;min-width:0;padding:7px 9px;transition:all .18s;display:flex}.crm-stale-deals__list button:hover{color:#d8f5f1;border-color:#3f6d89}.crm-stale-deals__list span{text-overflow:ellipsis;white-space:nowrap;font-size:9px;overflow:hidden}.crm-stale-deals__list strong{color:#51dbc8;flex:none;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px}.crm-board-shell{background:#091320d9;border:1px solid #20354f;border-radius:15px;margin-bottom:18px;padding:1px;box-shadow:inset 0 1px #ffffff06,0 18px 40px #0000001f}.crm-board-scroll{grid-template-columns:repeat(5,minmax(168px,1fr));gap:8px;min-width:865px;padding:10px;display:grid}.crm-stage{background:linear-gradient(#101d2ff0,#0a1523e0);border:1px solid #192e46;border-radius:11px;min-width:0;min-height:338px;padding:10px 9px 8px}.crm-stage:hover{border-color:var(--stage-color)}@supports (color:color-mix(in lab,red,red)){.crm-stage:hover{border-color:color-mix(in srgb,var(--stage-color),#1b2a3f 58%)}}.crm-stage__header{border-bottom:1px solid #1b3048;padding:2px 4px 10px}.crm-stage__title{color:#edf6ff;align-items:center;gap:6px;font-size:11px;font-weight:750;display:flex}.crm-stage__dot{background:var(--stage-color);width:7px;height:7px;box-shadow:0 0 9px var(--stage-color);border-radius:50%}@supports (color:color-mix(in lab,red,red)){.crm-stage__dot{box-shadow:0 0 9px color-mix(in srgb,var(--stage-color),transparent 15%)}}.crm-stage__count{background:var(--stage-color);border-radius:5px;min-width:19px;height:18px;margin-left:auto;padding:0 5px}@supports (color:color-mix(in lab,red,red)){.crm-stage__count{background:color-mix(in srgb,var(--stage-color),transparent 83%)}}.crm-stage__count{color:var(--stage-color);justify-content:center;align-items:center;font-size:10px;display:inline-flex}.crm-stage__total{color:#728da9;margin-top:5px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;display:block}.crm-stage__cards{height:268px;margin:8px 0;padding-right:2px;overflow-y:auto}.crm-deal-card{cursor:grab;background:linear-gradient(145deg,#13243a,#0e1a2b);border:1px solid #213851;border-radius:8px;margin-bottom:7px;padding:9px 9px 8px;transition:border-color .18s,transform .18s,box-shadow .18s}.crm-deal-card:hover{border-color:#3f7699;transform:translateY(-1px);box-shadow:0 8px 18px #0000002e}.crm-deal-card:active{cursor:grabbing}.crm-deal-card__top{color:#6685a4;justify-content:space-between;gap:4px;font-size:9px;display:flex}.crm-deal-card__top svg{color:#6e87a3}.crm-deal-card h3{color:#eef7ff;white-space:nowrap;text-overflow:ellipsis;margin:6px 0 10px;font-size:11px;font-weight:650;line-height:1.25;overflow:hidden}.crm-deal-card__footer{border-top:1px solid #20364f;justify-content:space-between;align-items:center;padding-top:7px;display:flex}.crm-deal-card__footer strong{color:#d7e6f7;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:650}.crm-deal-card__person{align-items:center;gap:5px;display:flex}.crm-deal-card__person img{object-fit:cover;border:1px solid #4d6a83;border-radius:50%;width:19px;height:19px}.crm-won{color:#2c