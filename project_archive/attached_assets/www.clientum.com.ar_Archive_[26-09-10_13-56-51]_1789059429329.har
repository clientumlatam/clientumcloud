            "text": "<!doctype html>\n<html lang=\"es-AR\" class=\"h-full\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <meta name=\"application-name\" content=\"ClientumCRM\" />\n    <meta name=\"theme-color\" content=\"#0f172a\" />\n    <link rel=\"canonical\" href=\"https://clientum.com.ar/\" />\n    <title>ClientumCRM | CRM comercial para PyMEs en Argentina</title>\n    <meta\n      name=\"description\"\n      content=\"ClientumCRM es el CRM comercial para PyMEs argentinas: WhatsApp, pipeline Kanban, seguimiento de clientes y facturación AFIP en un solo lugar.\"\n    />\n    <meta property=\"og:locale\" content=\"es_AR\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content=\"https://clientum.com.ar/\" />\n    <meta\n      property=\"og:title\"\n      content=\"ClientumCRM | CRM comercial para PyMEs en Argentina\"\n    />\n    <meta\n      property=\"og:description\"\n      content=\"Organizá tus ventas, conversaciones de WhatsApp y clientes en un solo CRM pensado para PyMEs argentinas.\"\n    />\n    <meta property=\"og:image\" content=\"https://clientum.com.ar/og-image.png\" />\n    <meta property=\"og:image:width\" content=\"1200\" />\n    <meta property=\"og:image:height\" content=\"630\" />\n    <meta property=\"og:image:alt\" content=\"ClientumCRM, CRM comercial para PyMEs argentinas\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta\n      name=\"twitter:title\"\n      content=\"ClientumCRM | CRM comercial para PyMEs en Argentina\"\n    />\n    <meta\n      name=\"twitter:description\"\n      content=\"El CRM comercial argentino para convertir conversaciones en ventas.\"\n    />\n    <meta name=\"twitter:image\" content=\"https://clientum.com.ar/og-image.png\" />\n    <link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.c