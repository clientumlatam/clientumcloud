ente en cuanto se cierra la oportunidad.\"}];return i.jsxs(\"div\",{className:\"bg-white text-slate-900 space-y-24 pb-20\",children:[i.jsx(\"section\",{className:\"relative pt-14 pb-16 lg:pt-20 lg:pb-24 overflow-hidden border-b border-slate-200 bg-gradient-to-b from-slate-50 to-white\",children:i.jsx(\"div\",{className:\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative\",children:i.jsxs(\"div\",{className:\"text-center max-w-3xl mx-auto space-y-6\",children:[i.jsxs(\"div\",{className:\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-200 text-xs font-semibold text-blue-800 shadow-xs\",children:[i.jsx(\"span\",{className:\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"}),i.jsx(\"span\",{children:\"Plataforma Comercial Omnicanal • +1.750 PyMEs en Cono Sur\"})]}),i.jsxs(\"h1\",{className:\"text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]\",children:[\"El CRM comercial que convierte tus\",\" \",i.jsx(\"span\",{className:\"text-blue-600\",children:\"Conversaciones en Ventas\"})]}),i.jsx(\"p\",{className:\"text-base sm:text-lg text-slate-600 leading-relaxed\",children:\"Unifica WhatsApp, pipeline visual Kanban y facturación AFIP en una sola plataforma. Operá con soporte humano, moneda local y herramientas pensadas para PyMEs latinoamericanas.\"}),i.jsxs(\"div\",{className:\"pt-2 flex flex-col sm:flex-row items-center justify-center gap-3\",children:[i.jsxs(\"button\",{onClick:()=>c(),className:\"w-full sm:w-auto px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md shadow-blue-600/20 flex items-center justify-center gap-2 transition-all duration-150 cursor-pointer\",children:[i.jsx(\"span\",{children:\"Probar Demo Interactiva Gratis\"}),i.jsx(mt,{className:\"w-4 h-4\"})]}),i.jsxs(\"button\",{onClick:s,className:\"w-full sm:w-auto px-6 py-3 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-bold text-sm shadow-xs flex ite